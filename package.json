{
  "name": "bravado-client-generator",
  "version": "1.0.0",
  "description": "Code generator for Bravado API clients",
  "type": "module",
  "main": "lib/main.js",
  "packageManager": "pnpm@11.15.1",
  "bin": {
    "bravado-client-generator": "bin/generate"
  },
  "exports": {
    "require": "./lib/main.js",
    "import": "./lib/main.js",
    "default": "./lib/main.js"
  },
  "scripts": {
    "reinstall": "rm -rf node_modules && pnpm install",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "lint:changed": "lint-staged",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Losant <hello@losant.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Losant/bravado-client-generator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Losant/bravado-client-generator.git"
  },
  "lint-staged": {
    "*.js": "eslint"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "debug": "^4.4.3",
    "fast-json-stable-stringify": "^2.1.0",
    "fs-extra": "^11.3.6",
    "handlebars": "^4.7.9",
    "inflection": "^3.0.2",
    "json-refs": "^3.0.15",
    "lodash": "^4.18.1",
    "qs": "^6.15.3",
    "uri-template": "^2.0.0"
  },
  "devDependencies": {
    "@losant/eslint-config-losant": "^2.1.0",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0"
  }
}
